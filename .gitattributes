# Preserve generated CSV bytes (including historical CRLF line endings) and
# avoid enormous textual diffs for result tables.
outputs/**/*.csv -text -diff
docs/reports/**/*.csv -text -diff
# Preserve October import checksums; recognize their historical CRLF endings.
docs/results/**/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
